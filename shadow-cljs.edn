{:deps {:aliases [:shadow]}
 :builds
 {:test {:target           :node-test
         :output-to        "target/test/node-tests.js"
         :ns-regexp        "-test$"
         ;; Native async/await (CLJS >= 1.12.145) requires an ES2017+ feature
         ;; set so the Closure compiler does not transpile it away.
         :compiler-options {:output-feature-set :es2020}}}}
